<Window x:Class="AuctionPurchase.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AuctionPurchase.UI"
        mc:Ignorable="d"
        Title="Auction Purchase"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeSurface_1A1A2E_Surface}">

    <Window.Resources>
        <!-- Nav button style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_B0B8D1_Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="4,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeSurface_2A2A4A_Surface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonActiveStyle" BasedOn="{StaticResource NavButtonStyle}" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Action button style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3451D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurface_555577_Surface}"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_2D2D4E_Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_B0B8D1_Text}"/>
        </Style>
        <Style x:Key="DangerButton" BasedOn="{StaticResource PrimaryButton}" TargetType="Button">
            <Setter Property="Background" Value="#D62839"/>
        </Style>
        <Style x:Key="SuccessButton" BasedOn="{StaticResource PrimaryButton}" TargetType="Button">
            <Setter Property="Background" Value="#06A77D"/>
        </Style>

        <!-- TextBox style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_2A2A4A_Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurface_3A3A5C_Surface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4361EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_2A2A4A_Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurface_3A3A5C_Surface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- DataGrid style -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_16213E_Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_D0D8F0_Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="{DynamicResource ThemeSurface_1E2748_Surface}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeSurface_16213E_Surface}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeSurface_2A2A4A_Surface}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_0F3460_Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurface_1A1A40_Surface}"/>
        </Style>

        <!-- Card style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_16213E_Surface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label style -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_8890AB_Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource ThemeSurface_0F3460_Surface}">
            <DockPanel>
                <!-- Logo area -->
                <Border DockPanel.Dock="Top" Padding="16,24,16,16">
                    <StackPanel>
                        <TextBlock Text="🍃 Auction Purchase" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"/>
                        <TextBlock Text="Tea procurement workspace" FontSize="11" Foreground="{DynamicResource ThemeText_7A88AA_Text}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource ThemeSurface_1E3A5F_Surface}" Margin="12,0"/>

                <!-- Nav items -->
                <StackPanel DockPanel.Dock="Top" Margin="8,16,8,0">
                    <Button x:Name="BtnDashboard" Content="📊  Dashboard"
                            Style="{StaticResource NavButtonActiveStyle}"
                            Click="NavButton_Click" Tag="Dashboard"/>
                    <Button x:Name="BtnNewSale" Content="➕  New Sale"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="NewSale"/>
                    <Button x:Name="BtnSalesList" Content="📋  Sales List"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="SalesList"/>
                    <Button x:Name="BtnReports" Content="📄  Reports"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="Reports"/>

                    <Rectangle Height="1" Fill="{DynamicResource ThemeSurface_1E3A5F_Surface}" Margin="4,12"/>
                    <TextBlock Text="MASTER DATA" Foreground="{DynamicResource ThemeText_4A5A7A_Text}" FontSize="10"
                               FontWeight="Bold" Margin="16,4,0,4"/>
                    <Button x:Name="BtnBrands" Content="🏷  Brands"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="Brands"/>
                    <Button x:Name="BtnBrokers" Content="🤝  Brokers"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="Brokers"/>
                    <Button x:Name="BtnGardens" Content="🌱  Gardens"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="Gardens"/>
                    <Button x:Name="BtnGrades" Content="⭐  Grades"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="Grades"/>
                    <Button x:Name="BtnCompanies" Content="🏢  Companies"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="Companies"/>
                    <Button x:Name="BtnSheds" Content="🏭  Sheds"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="Sheds"/>
                    <Button x:Name="BtnBlends" Content="🔀  Blends"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="Blends"/>

                    <Rectangle Height="1" Fill="{DynamicResource ThemeSurface_1E3A5F_Surface}" Margin="4,12"/>
                    <Button x:Name="BtnSettings" Content="⚙️  Settings"
                            Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click" Tag="Settings"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main Content Frame -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
               Background="{DynamicResource ThemeSurface_1A1A2E_Surface}"/>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="20,11" BorderThickness="0,1,0,0"
                Background="{DynamicResource ThemeSurface_16213E_Surface}"
                BorderBrush="{DynamicResource ThemeSurface_1E3A5F_Surface}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="12" Foreground="{DynamicResource ThemeText_8890AB_Text}" VerticalAlignment="Center">
                    <Run Text="Created by "/><Run Text="TMM" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"/>
                </TextBlock>
                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeText_8890AB_Text}">
                    <Hyperlink NavigateUri="https://www.linkedin.com/in/talhamm/" RequestNavigate="AuthorLink_RequestNavigate"
                               Foreground="{DynamicResource ThemeText_60A5FA_Text}" ToolTip="TMM on LinkedIn">LinkedIn</Hyperlink>
                    <Run Text="   ·   "/>
                    <Hyperlink NavigateUri="https://github.com/talha-m-m" RequestNavigate="AuthorLink_RequestNavigate"
                               Foreground="{DynamicResource ThemeText_60A5FA_Text}" ToolTip="TMM on GitHub">GitHub</Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>

