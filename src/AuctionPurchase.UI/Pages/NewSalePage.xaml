<Page x:Class="AuctionPurchase.UI.Pages.NewSalePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:AuctionPurchase.UI.Services"
      Background="{DynamicResource ThemeSurface_1A1A2E_Surface}" FontFamily="Segoe UI">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Cell styles for highlighting unmatched items in rows -->
        <Style x:Key="BrandCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBrandUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Brand is unmatched or missing. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBrandUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BrokerCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBrokerUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Broker is unmatched or missing. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBrokerUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LotNoCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLotNoUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Lot No is required. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLotNoUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GardenCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGardenUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Garden does not match master data. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGardenUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GradeCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGradeUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Grade is unmatched or missing. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGradeUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BagsCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBagsUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Bags must be greater than 0. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBagsUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KgsCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKgsUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="KGs must be greater than 0. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsKgsUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PriceCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPriceUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Price must be greater than 0. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPriceUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShedCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShedUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Shed does not match master data. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsShedUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BlendCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBlendUnmatched}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_5C1D27_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFB3BC_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="ToolTip" Value="Blend does not match master data. Double-click row to edit."/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBlendUnmatched}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_8A1C28_Surface}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorder}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeSurface_16213E_Surface}" Padding="28,20">
            <Border.Effect>
                <DropShadowEffect Color="#000" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtPageTitle" Text="New Sale Entry" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"/>
                    <TextBlock x:Name="TxtPageSubtitle" Text="Enter sale details and add auction lot entries below" FontSize="12" Foreground="{DynamicResource ThemeText_6B7A9A_Text}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnDownloadTemplate" Content="Template" Width="100" Height="38" Margin="0,0,8,0"
                            Background="#4361EE" Foreground="White" BorderThickness="0"
                            FontSize="13" Cursor="Hand" Click="BtnDownloadTemplate_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnUploadExcel" Content="Upload Excel" Width="110" Height="38" Margin="0,0,16,0"
                            Background="#D62839" Foreground="White" BorderThickness="0"
                            FontSize="13" Cursor="Hand" Click="BtnUploadExcel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnSaveSale" Content="Save Sale" Width="120" Height="38"
                            Background="#06A77D" Foreground="White" BorderThickness="0"
                            FontSize="13" Cursor="Hand" Click="BtnSaveSale_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface_058060_Surface}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnClearSale" Content="Clear" Width="80" Height="38" Margin="8,0,0,0"
                            Background="{DynamicResource ThemeSurface_2D2D4E_Surface}" Foreground="{DynamicResource ThemeText_B0B8D1_Text}" BorderThickness="0"
                            FontSize="13" Cursor="Hand" Click="BtnClearSale_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sale Header Form -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeSurface_16213E_Surface}" Margin="20,16,20,0" CornerRadius="12" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="SALE NO" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtSaleNo" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="SALE DATE" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DtpSaleDate" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="NOTES" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtNotes" FontSize="13" ToolTip="Optional notes..."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Entry Form + Grid -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeSurface_16213E_Surface}" Margin="20,12,20,0" CornerRadius="12" Padding="24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="Auction Lot Entries" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeText_8890AB_Text}" VerticalAlignment="Center"/>
                    <Border x:Name="PnlEditModeNotice" Background="{DynamicResource ThemeSurface_5C1D27_Surface}" BorderBrush="#E63946" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="16,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="⚠️ Editing Row — Unmatched fields are highlighted in red" Foreground="{DynamicResource ThemeText_FFE0B2_Text}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Entry input row -->
                <Border Grid.Row="1" Background="{DynamicResource ThemeSurface_0F1F3D_Surface}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                    <UniformGrid Columns="7">

                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Brand" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbBrand" DisplayMemberPath="Name"
                                      IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"
                                      TextSearch.TextPath="Name"
                                      Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                      SelectionChanged="CmbField_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Broker" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbBroker" DisplayMemberPath="Name"
                                      IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"
                                      TextSearch.TextPath="Name"
                                      Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                      SelectionChanged="CmbField_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Lot No" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtLotNo" KeyDown="EntryField_KeyDown" TextChanged="FormField_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Garden" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbGarden" DisplayMemberPath="Name"
                                      IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"
                                      TextSearch.TextPath="Name"
                                      Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                      SelectionChanged="CmbField_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Account" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAccount" DisplayMemberPath="Name" TextSearch.TextPath="Name"
                                      IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"
                                      Foreground="{DynamicResource ThemeText_FFFFFF_Text}" IsEnabled="False" ToolTip="Select a garden first. Account defaults to that garden."
                                      SelectionChanged="CmbField_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Invoice" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtInvoiceNo" KeyDown="EntryField_KeyDown"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Grade" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbGrade" DisplayMemberPath="Name"
                                      IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"
                                      TextSearch.TextPath="Name"
                                      Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                      SelectionChanged="CmbField_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Bags" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtBags" KeyDown="EntryField_KeyDown" TextChanged="ValueField_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="KGs" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtKgs" KeyDown="EntryField_KeyDown" TextChanged="ValueField_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Price/KG" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPrice" KeyDown="EntryField_KeyDown" TextChanged="ValueField_Changed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Value" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtValue" Background="{DynamicResource ThemeSurface_141829_Surface}" Foreground="{DynamicResource ThemeText_F7A400_Text}"
                                     IsReadOnly="True" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Shed" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbShed" DisplayMemberPath="Name"
                                      IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"
                                      TextSearch.TextPath="Name"
                                      Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                      SelectionChanged="CmbField_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Text="Blend" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbBlend" DisplayMemberPath="Name"
                                      IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False" MaxDropDownHeight="260"
                                      TextSearch.TextPath="Name"
                                      Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                      SelectionChanged="CmbField_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                            <Button x:Name="BtnAddEntry" Content="+ Add" Width="70" Height="34"
                                    Background="#4361EE" Foreground="White" BorderThickness="0"
                                    FontSize="12" FontWeight="Bold" Cursor="Hand" Click="BtnAddEntry_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3451D1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnCancelEdit" Content="Cancel" Width="55" Height="34" Margin="6,0,0,0"
                                    Background="{DynamicResource ThemeSurface_2D2D4E_Surface}" Foreground="{DynamicResource ThemeText_B0B8D1_Text}" BorderThickness="0"
                                    FontSize="11" Cursor="Hand" Click="BtnCancelEdit_Click" Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurface_3D3D6E_Surface}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Entries Grid -->
                <DataGrid ui:TableLayout.Enabled="True" Grid.Row="2" x:Name="GridEntries" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="{DynamicResource ThemeSurface_16213E_Surface}" Foreground="{DynamicResource ThemeText_D0D8F0_Text}" BorderThickness="1" BorderBrush="{DynamicResource TableBorder}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ThemeSurface_1A2540_Surface}"
                          HeadersVisibility="Column" SelectionMode="Single"
                          CanUserReorderColumns="False" CanUserResizeRows="False" FontSize="12"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="MouseDoubleClick" Handler="GridEntriesRow_MouseDoubleClick"/>
                            <Setter Property="Background" Value="{DynamicResource ThemeSurface_1E2748_Surface}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeText_D0D8F0_Text}"/>
                            <Setter Property="ToolTip" Value="Double-click row to edit this lot"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEmptyField}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_4D2A12_Surface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFE0B2_Text}"/>
                                    <Setter Property="ToolTip" Value="Row has empty or unmatched fields. Double-click row to edit."/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasEmptyField}" Value="True"/>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_613617_Surface}"/>
                                </MultiDataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ThemeSurface_2A4A8A_Surface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Brand" Binding="{Binding BrandDisplay}" Width="140" CellStyle="{StaticResource BrandCellStyle}" SortMemberPath="BrandName"/>
                        <DataGridTextColumn Header="Broker" Binding="{Binding BrokerDisplay}" Width="80" CellStyle="{StaticResource BrokerCellStyle}" SortMemberPath="BrokerName"/>
                        <DataGridTextColumn Header="Lot No" Binding="{Binding LotNoDisplay}" Width="70" CellStyle="{StaticResource LotNoCellStyle}" SortMemberPath="LotNo"/>
                        <DataGridTextColumn Header="Garden" Binding="{Binding GardenDisplay}" Width="130" MinWidth="100" CellStyle="{StaticResource GardenCellStyle}" SortMemberPath="GardenName"/>
                        <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="130"/>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="90"/>
                        <DataGridTextColumn Header="Grade" Binding="{Binding GradeDisplay}" Width="90" CellStyle="{StaticResource GradeCellStyle}" SortMemberPath="GradeName"/>
                        <DataGridTextColumn Header="Bags" Binding="{Binding BagsDisplay}" Width="55" CellStyle="{StaticResource BagsCellStyle}" SortMemberPath="NumberOfBags"/>
                        <DataGridTextColumn Header="KGs" Binding="{Binding KgsDisplay}" Width="80" CellStyle="{StaticResource KgsCellStyle}" SortMemberPath="TotalKgs"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding PriceDisplay}" Width="75" CellStyle="{StaticResource PriceCellStyle}" SortMemberPath="PricePerKg"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="Shed" Binding="{Binding ShedDisplay}" Width="90" CellStyle="{StaticResource ShedCellStyle}" SortMemberPath="ShedName"/>
                        <DataGridTextColumn Header="Blend" Binding="{Binding BlendDisplay}" Width="90" CellStyle="{StaticResource BlendCellStyle}" SortMemberPath="BlendName"/>
                        <DataGridTemplateColumn Header="Action" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Edit" Background="Transparent" Foreground="{DynamicResource ThemeText_75A7FF_Text}"
                                                BorderThickness="0" FontSize="11" FontWeight="Bold" Cursor="Hand"
                                                Click="BtnEditEntry_Click" Tag="{Binding}"/>
                                        <Button Content="Delete" Background="Transparent" Foreground="{DynamicResource ThemeText_D62839_Text}"
                                                BorderThickness="0" FontSize="11" FontWeight="Bold" Cursor="Hand"
                                                Margin="6,0,0,0" Click="BtnRemoveEntry_Click" Tag="{Binding}"/>
                                        <TextBlock Text="⚠️" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip="Row has empty or unmatched fields. Double-click to edit."
                                                   Visibility="{Binding HasEmptyField, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer Totals -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeSurface_0F3460_Surface}" Margin="20,8,20,16" CornerRadius="10" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtEntryCount" Text="0 entries" Foreground="{DynamicResource ThemeText_6B7A9A_Text}" VerticalAlignment="Center" FontSize="13"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="Total Bags: " Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalBagsFooter" Text="0" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="Total KGs: " Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalKgsFooter" Text="0.00" Foreground="{DynamicResource ThemeText_06A77D_Text}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="Total Value: " Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTotalValueFooter" Text="৳0.00" Foreground="{DynamicResource ThemeText_F7A400_Text}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
