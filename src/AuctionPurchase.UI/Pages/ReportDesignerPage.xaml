<Page x:Class="AuctionPurchase.UI.Pages.ReportDesignerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeSurface_1A1A2E_Surface}" FontFamily="Segoe UI">

    <Page.Resources>
        <!-- Small action button -->
        <Style x:Key="SmBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_2D2D4E_Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_B0B8D1_Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurface_3D3D6E_Surface}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimBtn" TargetType="Button">
            <Setter Property="Background" Value="#4361EE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3451D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_8890AB_Text}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="PropInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_2A2A4A_Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurface_3A3A5C_Surface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PropCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_2A2A4A_Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurface_3A3A5C_Surface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Main 3-panel area -->
            <RowDefinition Height="Auto"/>  <!-- Status / Preview toggle -->
            <RowDefinition x:Name="PreviewRow" Height="0"/> <!-- Preview panel -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             TOOLBAR
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeSurface_0F1628_Surface}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Report Designer" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeText_FFFFFF_Text}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <ComboBox Grid.Column="1" x:Name="CmbTemplates" Height="34"
                          Background="{DynamicResource ThemeSurface_2A2A4A_Surface}" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" BorderBrush="{DynamicResource ThemeSurface_3A3A5C_Surface}"
                          SelectionChanged="TemplateChanged" Margin="0,0,8,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TxtTemplateName" Width="200" Height="34" Style="{StaticResource PropInput}"
                             Margin="0,0,8,0"/>
                    <Button Content="💾 Save"    Style="{StaticResource PrimBtn}" Margin="0,0,6,0" Height="34"
                            Click="BtnSave_Click"/>
                    <Button Content="Save As"    Style="{StaticResource SmBtn}" Margin="0,0,6,0" Height="34"
                            Click="BtnSaveAs_Click"/>
                    <Button Content="⧉ Duplicate" Style="{StaticResource SmBtn}" Margin="0,0,6,0" Height="34"
                            Click="BtnDuplicate_Click"/>
                    <Button Content="↺ Reset"    Style="{StaticResource SmBtn}" Margin="0,0,6,0" Height="34"
                            Click="BtnReset_Click"/>
                    <Rectangle Width="1" Fill="{DynamicResource ThemeSurface_3A3A5C_Surface}" Margin="6,4"/>
                    <Button Content="📤 Export"  Style="{StaticResource SmBtn}" Margin="0,0,6,0" Height="34"
                            Click="BtnExport_Click"/>
                    <Button Content="📥 Import"  Style="{StaticResource SmBtn}" Margin="0,0,6,0" Height="34"
                            Click="BtnImport_Click"/>
                    <Rectangle Width="1" Fill="{DynamicResource ThemeSurface_3A3A5C_Surface}" Margin="6,4"/>
                    <Button x:Name="BtnTogglePreview" Content="👁 Preview" Style="{StaticResource SmBtn}"
                            Height="34" Click="BtnTogglePreview_Click"/>
                </StackPanel>

                <Button Grid.Column="3" Content="← Templates" Style="{StaticResource SmBtn}"
                        Height="34" Margin="16,0,0,0" Click="BtnBack_Click"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             MAIN 3-PANEL AREA
        ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>   <!-- LEFT: page setup + variables -->
                <ColumnDefinition Width="*"/>     <!-- CENTER: designer canvas -->
                <ColumnDefinition Width="240"/>   <!-- RIGHT: property editor -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL ─────────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeSurface_0F1628_Surface}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <!-- Page Setup -->
                        <TextBlock Text="Page Setup" Style="{StaticResource SectionLabel}" Margin="0,4,0,8"/>
                        <TextBlock Text="Page Size" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbPageSize" Style="{StaticResource PropCombo}" Height="30">
                            <ComboBoxItem Content="A4"/>
                            <ComboBoxItem Content="Letter"/>
                            <ComboBoxItem Content="Legal"/>
                        </ComboBox>
                        <TextBlock Text="Orientation" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbOrientation" Style="{StaticResource PropCombo}" Height="30">
                            <ComboBoxItem Content="Portrait"/>
                            <ComboBoxItem Content="Landscape" IsSelected="True"/>
                        </ComboBox>
                        <TextBlock Text="Margins (mm)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,3,3">
                                <TextBlock Text="Top" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="10"/>
                                <TextBox x:Name="TxtMarginTop" Style="{StaticResource PropInput}" Height="26" Text="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="3,0,0,3">
                                <TextBlock Text="Bottom" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="10"/>
                                <TextBox x:Name="TxtMarginBottom" Style="{StaticResource PropInput}" Height="26" Text="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,3,0">
                                <TextBlock Text="Left" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="10"/>
                                <TextBox x:Name="TxtMarginLeft" Style="{StaticResource PropInput}" Height="26" Text="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="3,0,0,0">
                                <TextBlock Text="Right" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="10"/>
                                <TextBox x:Name="TxtMarginRight" Style="{StaticResource PropInput}" Height="26" Text="10"/>
                            </StackPanel>
                        </Grid>

                        <!-- Body Options -->
                        <Rectangle Height="1" Fill="{DynamicResource ThemeSurface_1E2748_Surface}" Margin="0,14,0,10"/>
                        <TextBlock Text="Body Options" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkShowTotals" Content="Show Totals Row"
                                  Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontSize="12" IsChecked="True" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkAlternateRows" Content="Alternate Row Shading"
                                  Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontSize="12" IsChecked="True" Margin="0,0,0,6"/>
                        <TextBlock Text="Header BG" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtHeaderBg" Style="{StaticResource PropInput}" Height="26" Text="#1A3A6A"/>
                        <TextBlock Text="Header Text" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtHeaderFg" Style="{StaticResource PropInput}" Height="26" Text="#FFFFFF"/>
                        <TextBlock Text="Totals BG" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtTotalsBg" Style="{StaticResource PropInput}" Height="26" Text="#BDD7EE"/>
                        <TextBlock Text="Alt Row BG" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtAltRowBg" Style="{StaticResource PropInput}" Height="26" Text="#EEF2FF"/>

                        <!-- Variable reference -->
                        <Rectangle Height="1" Fill="{DynamicResource ThemeSurface_1E2748_Surface}" Margin="0,14,0,10"/>
                        <TextBlock Text="Global Variables" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                        <TextBlock Text="Click to insert into Content field below."
                                   Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="VarList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Style="{StaticResource SmBtn}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Margin="0,2" Padding="6,3" FontSize="11"
                                            Click="VarChip_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Field reference -->
                        <Rectangle Height="1" Fill="{DynamicResource ThemeSurface_1E2748_Surface}" Margin="0,10"/>
                        <TextBlock Text="Data Fields" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                        <TextBlock Text="Available for Column → Field" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="FieldList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource ThemeText_75E6B7_Text}" FontSize="11"
                                               Margin="0,1" Cursor="Hand"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── CENTER CANVAS ──────────────────────────── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,8">
                <StackPanel>

                    <!-- HEADER SECTION -->
                    <Border Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="📄 Header" Style="{StaticResource SectionLabel}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Add Element" Style="{StaticResource PrimBtn}" Height="28"
                                            Margin="0,0,6,0" Click="BtnAddHeaderElement_Click"/>
                                    <Button Content="↑" Style="{StaticResource SmBtn}" Width="28" Height="28"
                                            Margin="0,0,4,0" Click="BtnHeaderUp_Click"/>
                                    <Button Content="↓" Style="{StaticResource SmBtn}" Width="28" Height="28"
                                            Margin="0,0,4,0" Click="BtnHeaderDown_Click"/>
                                    <Button Content="×" Style="{StaticResource SmBtn}" Width="28" Height="28"
                                            Foreground="{DynamicResource ThemeText_FF6B6B_Text}" Click="BtnHeaderDelete_Click"/>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="LstHeader" Background="{DynamicResource ThemeSurface_0F1628_Surface}" BorderThickness="1"
                                     BorderBrush="{DynamicResource ThemeSurface_2A2A4A_Surface}" MinHeight="80" SelectionChanged="HeaderElementSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource ThemeSurface_1A3A6A_Surface}" CornerRadius="3" Padding="4,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ElementType}" FontSize="10"
                                                           Foreground="{DynamicResource ThemeText_75E6B7_Text}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Content}"
                                                       Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Alignment}"
                                                       Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurface_1E3A6A_Surface}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- BODY / TABLE COLUMNS SECTION -->
                    <Border Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="📊 Table Columns" Style="{StaticResource SectionLabel}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Add Column" Style="{StaticResource PrimBtn}" Height="28"
                                            Margin="0,0,6,0" Click="BtnAddColumn_Click"/>
                                    <Button Content="↑" Style="{StaticResource SmBtn}" Width="28" Height="28"
                                            Margin="0,0,4,0" Click="BtnColumnUp_Click"/>
                                    <Button Content="↓" Style="{StaticResource SmBtn}" Width="28" Height="28"
                                            Margin="0,0,4,0" Click="BtnColumnDown_Click"/>
                                    <Button Content="×" Style="{StaticResource SmBtn}" Width="28" Height="28"
                                            Foreground="{DynamicResource ThemeText_FF6B6B_Text}" Click="BtnColumnDelete_Click"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="GridColumns" AutoGenerateColumns="False"
                                      CanUserAddRows="False" MinHeight="120"
                                      Background="{DynamicResource ThemeSurface_0F1628_Surface}" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                      RowBackground="{DynamicResource ThemeSurface_16213E_Surface}" AlternatingRowBackground="{DynamicResource ThemeSurface_0F1628_Surface}"
                                      BorderThickness="1" BorderBrush="{DynamicResource TableBorder}" SelectionChanged="ColumnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Field"   Binding="{Binding Field}"   Width="110"/>
                                    <DataGridTextColumn Header="Title"   Binding="{Binding Title}"   Width="100"/>
                                    <DataGridTextColumn Header="Width"   Binding="{Binding Width}"   Width="55"/>
                                    <DataGridTextColumn Header="Align"   Binding="{Binding Alignment}" Width="65"/>
                                    <DataGridTextColumn Header="Format"  Binding="{Binding Format}"  Width="70"/>
                                    <DataGridCheckBoxColumn Header="Vis" Binding="{Binding IsVisible}" Width="40"/>
                                    <DataGridCheckBoxColumn Header="∑"   Binding="{Binding IncludeInTotal}" Width="35"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- FOOTER SECTION -->
                    <Border Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="📋 Footer" Style="{StaticResource SectionLabel}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Add Element" Style="{StaticResource PrimBtn}" Height="28"
                                            Margin="0,0,6,0" Click="BtnAddFooterElement_Click"/>
                                    <Button Content="↑" Style="{StaticResource SmBtn}" Width="28" Height="28"
                                            Margin="0,0,4,0" Click="BtnFooterUp_Click"/>
                                    <Button Content="↓" Style="{StaticResource SmBtn}" Width="28" Height="28"
                                            Margin="0,0,4,0" Click="BtnFooterDown_Click"/>
                                    <Button Content="×" Style="{StaticResource SmBtn}" Width="28" Height="28"
                                            Foreground="{DynamicResource ThemeText_FF6B6B_Text}" Click="BtnFooterDelete_Click"/>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="LstFooter" Background="{DynamicResource ThemeSurface_0F1628_Surface}" BorderThickness="1"
                                     BorderBrush="{DynamicResource ThemeSurface_2A2A4A_Surface}" MinHeight="60" SelectionChanged="FooterElementSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource ThemeSurface_2A1A3A_Surface}" CornerRadius="3" Padding="4,2"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ElementType}" FontSize="10"
                                                           Foreground="{DynamicResource ThemeText_C9A0FF_Text}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Content}"
                                                       Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="8,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Alignment}"
                                                       Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurface_2A1A3A_Surface}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── RIGHT PROPERTY PANEL ───────────────────── -->
            <Border Grid.Column="2" Background="{DynamicResource ThemeSurface_0F1628_Surface}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Properties" Style="{StaticResource SectionLabel}" Margin="0,4,0,12"/>

                        <!-- Nothing selected -->
                        <TextBlock x:Name="TxtNoSelection" Text="Select an element in the header,&#xa;footer, or a column to edit its properties."
                                   Foreground="{DynamicResource ThemeText_4A5A7A_Text}" FontSize="12" TextWrapping="Wrap"/>

                        <!-- Element properties (shown when header/footer element selected) -->
                        <StackPanel x:Name="PanelElementProps" Visibility="Collapsed">
                            <TextBlock Text="Element Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PropType" Style="{StaticResource PropCombo}" Height="30"
                                      SelectionChanged="PropType_Changed">
                                <ComboBoxItem Content="Text"/>
                                <ComboBoxItem Content="Field"/>
                                <ComboBoxItem Content="CompanyLogo"/>
                                <ComboBoxItem Content="Line"/>
                                <ComboBoxItem Content="Separator"/>
                            </ComboBox>

                            <TextBlock Text="Content / Variable" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PropContent" Style="{StaticResource PropInput}" Height="60"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="PropValue_Changed"/>

                            <TextBlock Text="Alignment" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PropAlignment" Style="{StaticResource PropCombo}" Height="30"
                                      SelectionChanged="PropCombo_Changed">
                                <ComboBoxItem Content="Left"/>
                                <ComboBoxItem Content="Center"/>
                                <ComboBoxItem Content="Right"/>
                            </ComboBox>

                            <TextBlock Text="Font Family" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PropFontFamily" Style="{StaticResource PropCombo}" Height="30"
                                      IsEditable="True" SelectionChanged="PropCombo_Changed">
                                <ComboBoxItem Content="Segoe UI"/>
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Times New Roman"/>
                                <ComboBoxItem Content="Calibri"/>
                                <ComboBoxItem Content="Verdana"/>
                                <ComboBoxItem Content="Tahoma"/>
                                <ComboBoxItem Content="Georgia"/>
                            </ComboBox>

                            <TextBlock Text="Font Size (pt)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PropFontSize" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="PropValue_Changed"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="PropBold"      Content="Bold"   Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                          FontSize="12" Grid.Column="0" Checked="PropCheck_Changed" Unchecked="PropCheck_Changed"/>
                                <CheckBox x:Name="PropItalic"    Content="Italic" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                          FontSize="12" Grid.Column="1" Checked="PropCheck_Changed" Unchecked="PropCheck_Changed"/>
                                <CheckBox x:Name="PropUnderline" Content="Underline" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                          FontSize="12" Grid.Column="2" Checked="PropCheck_Changed" Unchecked="PropCheck_Changed"/>
                            </Grid>

                            <TextBlock Text="Text Color (#hex)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PropTextColor" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="PropValue_Changed"/>

                            <TextBlock Text="Background Color (#hex)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PropBgColor" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="PropValue_Changed"/>

                            <TextBlock Text="Logo Height (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PropLogoHeight" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="PropValue_Changed"/>
                        </StackPanel>

                        <!-- Column properties (shown when column selected) -->
                        <StackPanel x:Name="PanelColumnProps" Visibility="Collapsed">
                            <TextBlock Text="Field" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ColField" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="ColProp_Changed"/>
                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ColTitle" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="ColProp_Changed"/>
                            <TextBlock Text="Width (relative)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ColWidth" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="ColProp_Changed"/>
                            <TextBlock Text="Alignment" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ColAlignment" Style="{StaticResource PropCombo}" Height="30"
                                      SelectionChanged="ColCombo_Changed">
                                <ComboBoxItem Content="Left"/>
                                <ComboBoxItem Content="Center"/>
                                <ComboBoxItem Content="Right"/>
                            </ComboBox>
                            <TextBlock Text="Format (N0, N2, C2, …)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ColFormat" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="ColProp_Changed"/>
                            <TextBlock Text="Decimal Precision" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ColDecimal" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="ColProp_Changed"/>
                            <TextBlock Text="Date Format" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ColDateFormat" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="ColProp_Changed"/>
                            <TextBlock Text="Text Color (#hex)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ColTextColor" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="ColProp_Changed"/>
                            <TextBlock Text="Background (#hex)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ColBgColor" Style="{StaticResource PropInput}" Height="28"
                                     TextChanged="ColProp_Changed"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ColBold"    Content="Bold"    Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                          FontSize="12" Grid.Column="0" Checked="ColCheck_Changed" Unchecked="ColCheck_Changed"/>
                                <CheckBox x:Name="ColVisible" Content="Visible" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                          FontSize="12" Grid.Column="1" IsChecked="True"
                                          Checked="ColCheck_Changed" Unchecked="ColCheck_Changed"/>
                            </Grid>
                            <CheckBox x:Name="ColTotal" Content="Include in Totals" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                      FontSize="12" Margin="0,6,0,0"
                                      Checked="ColCheck_Changed" Unchecked="ColCheck_Changed"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtPropStatus" Foreground="{DynamicResource ThemeText_75E6B7_Text}" FontSize="11"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════
             STATUS BAR
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeSurface_0F1628_Surface}" Padding="16,6">
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource ThemeText_75E6B7_Text}" FontSize="12" VerticalAlignment="Center"/>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             PREVIEW PANEL (collapsible)
        ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" x:Name="PreviewPanel" Background="{DynamicResource ThemeSurface_0A0F1E_Surface}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Preview toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeSurface_0F1628_Surface}" Padding="12,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="◀◀ First"  Style="{StaticResource SmBtn}" Height="28" Margin="0,0,4,0"
                                    Click="PreviewFirst_Click"/>
                            <Button Content="◀ Prev"   Style="{StaticResource SmBtn}" Height="28" Margin="0,0,4,0"
                                    Click="PreviewPrev_Click"/>
                            <TextBlock x:Name="TxtPageInfo" Text="Page 1 of 1"
                                       Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                            <Button Content="Next ▶"   Style="{StaticResource SmBtn}" Height="28" Margin="0,0,4,0"
                                    Click="PreviewNext_Click"/>
                            <Button Content="Last ▶▶"  Style="{StaticResource SmBtn}" Height="28" Margin="0,0,12,0"
                                    Click="PreviewLast_Click"/>
                            <Slider x:Name="SldrZoom" Minimum="50" Maximum="200" Value="100" Width="100"
                                    VerticalAlignment="Center" ValueChanged="ZoomChanged"/>
                            <TextBlock x:Name="TxtZoom" Text="100%" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11"
                                       VerticalAlignment="Center" Margin="6,0"/>
                        </StackPanel>
                        <Button Content="✖ Close Preview" Style="{StaticResource SmBtn}" HorizontalAlignment="Right"
                                Height="28" Click="BtnClosePreview_Click"/>
                    </Grid>
                </Border>

                <!-- Preview canvas -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" Background="{DynamicResource ThemeSurface_1A1A2E_Surface}">
                    <Border HorizontalAlignment="Center" Margin="20">
                        <Image x:Name="PreviewImage" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </ScrollViewer>

                <!-- Preview loading overlay -->
                <Grid Grid.Row="1" x:Name="PreviewLoading" Visibility="Collapsed" Background="#80000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Generating preview…" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
