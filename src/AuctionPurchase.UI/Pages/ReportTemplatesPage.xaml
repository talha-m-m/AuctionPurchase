<Page x:Class="AuctionPurchase.UI.Pages.ReportTemplatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:AuctionPurchase.UI.Services"
      Background="{DynamicResource ThemeSurface_1A1A2E_Surface}" FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface_2D2D4E_Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_B0B8D1_Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurface_3D3D6E_Surface}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Report Templates" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"/>
                <TextBlock Text="Manage custom report layouts. Each template drives PDF, Word and Excel exports."
                           Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnImport" Content="📥  Import .tktpl" Style="{StaticResource ActionBtn}"
                        Width="140" Height="36" Margin="0,0,8,0" Click="BtnImport_Click"/>
                <Button x:Name="BtnNew" Content="➕  New Template" Height="36" Width="140"
                        Background="#4361EE" Foreground="White" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="BtnNew_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3451D1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter bar -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Report Type:" Foreground="{DynamicResource ThemeText_8890AB_Text}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbFilterType" Width="180" Height="34"
                          Background="{DynamicResource ThemeSurface_2A2A4A_Surface}" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" BorderBrush="{DynamicResource ThemeSurface_3A3A5C_Surface}"
                          SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="All Types" IsSelected="True"/>
                    <ComboBoxItem Content="AllEntries"/>
                    <ComboBoxItem Content="BrandWise"/>
                    <ComboBoxItem Content="BrokerWise"/>
                </ComboBox>
                <TextBlock Text="Search:" Foreground="{DynamicResource ThemeText_8890AB_Text}" VerticalAlignment="Center" Margin="20,0,8,0"/>
                <TextBox x:Name="TxtSearch" Width="200" Height="34"
                         Background="{DynamicResource ThemeSurface_2A2A4A_Surface}" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" BorderBrush="{DynamicResource ThemeSurface_3A3A5C_Surface}"
                         BorderThickness="1" Padding="8,0" CaretBrush="{DynamicResource ThemeText_FFFFFF_Text}"
                         VerticalContentAlignment="Center" TextChanged="FilterChanged">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <Button x:Name="BtnRefresh" Content="🔄" Style="{StaticResource ActionBtn}"
                        Width="36" Height="36" Margin="8,0,0,0" ToolTip="Refresh" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Border>

        <!-- Templates list -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Grid Grid.Row="0" Background="{DynamicResource ThemeSurface_0F3460_Surface}" Margin="1,1,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Template Name" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontWeight="SemiBold"
                               Padding="16,10" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="Report Type" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontWeight="SemiBold"
                               Padding="8,10" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="Version" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontWeight="SemiBold"
                               Padding="8,10" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="Default" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontWeight="SemiBold"
                               Padding="8,10" FontSize="12"/>
                    <TextBlock Grid.Column="4" Text="Last Updated" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontWeight="SemiBold"
                               Padding="8,10" FontSize="12"/>
                    <TextBlock Grid.Column="5" Text="Actions" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" FontWeight="SemiBold"
                               Padding="8,10" FontSize="12"/>
                </Grid>

                <!-- Template rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TemplateList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RowBorder" Padding="0,4"
                                        BorderBrush="{DynamicResource ThemeSurface_1E2748_Surface}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="300"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Name -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,8">
                                            <TextBlock Text="⭐ " Foreground="{DynamicResource ThemeText_FFD700_Text}" FontSize="12"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding TemplateName}" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"
                                                       FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Report Type -->
                                        <TextBlock Grid.Column="1" Text="{Binding ReportType}"
                                                   Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="12"
                                                   VerticalAlignment="Center" Padding="8,0"/>

                                        <!-- Version -->
                                        <TextBlock Grid.Column="2" Text="{Binding Version}"
                                                   Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="12"
                                                   VerticalAlignment="Center" Padding="8,0"/>

                                        <!-- Default badge -->
                                        <Border Grid.Column="3" CornerRadius="4" Padding="6,2" Margin="8,6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeSurface_1A3A6A_Surface}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="False">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                <Setter Property="Text" Value="Default"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText_75E6B7_Text}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="False">
                                                                <Setter Property="Text" Value="Custom"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText_8890AB_Text}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Updated date -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{ui:PreferredDate UpdatedAt}"
                                                   Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="12"
                                                   VerticalAlignment="Center" Padding="8,0"/>

                                        <!-- Action buttons -->
                                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="8,0">
                                            <Button Content="✏ Edit" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,4,0" Height="28" Width="60"
                                                    Tag="{Binding TemplateId}" Click="BtnEdit_Click"/>
                                            <Button Content="⧉ Copy" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,4,0" Height="28" Width="60"
                                                    Tag="{Binding TemplateId}" Click="BtnDuplicate_Click"/>
                                            <Button Content="📤 Export" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,4,0" Height="28" Width="70"
                                                    Tag="{Binding TemplateId}" Click="BtnExport_Click"/>
                                            <Button Content="🗑 Delete" Height="28" Width="65"
                                                    Background="{DynamicResource ThemeSurface_3D1A1A_Surface}" Foreground="{DynamicResource ThemeText_FF6B6B_Text}"
                                                    BorderThickness="0" FontSize="12" Cursor="Hand"
                                                    Tag="{Binding TemplateId}" Click="BtnDelete_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                              Margin="6,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeSurface_5D2A2A_Surface}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.3"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ThemeSurface_0D1B33_Surface}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <TextBlock x:Name="TxtEmpty" Grid.Row="1" Text="No templates found."
                           Foreground="{DynamicResource ThemeText_4A5A7A_Text}" FontSize="14" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button Content="← Reports" HorizontalAlignment="Left" Height="34" Width="100"
                    Background="{DynamicResource ThemeSurface_2D2D4E_Surface}" Foreground="White" BorderThickness="0"
                    FontSize="13" Cursor="Hand" Click="BtnBack_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource ThemeText_75E6B7_Text}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
