<Page x:Class="AuctionPurchase.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:AuctionPurchase.UI.Services"
      Background="{DynamicResource ThemeSurface_1A1A2E_Surface}" FontFamily="Segoe UI">
    <Page.Resources>
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" Padding="16,8" Cursor="Hand" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4361EE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText_6B7A9A_Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText_FFFFFF_Text}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Settings" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" Margin="0,0,0,20"/>
        
        <!-- Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,24">
            <RadioButton x:Name="TabSystem" Content="System Settings" Style="{StaticResource TabButtonStyle}" IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabCompany" Content="Company Profile" Style="{StaticResource TabButtonStyle}" Margin="16,0,0,0" Checked="Tab_Checked"/>
            <RadioButton x:Name="TabBackup" Content="Backup &amp; Restore" Style="{StaticResource TabButtonStyle}" Margin="16,0,0,0" Checked="Tab_Checked"/>
        </StackPanel>

        <!-- System Settings -->
        <ScrollViewer x:Name="PanelSystem" Grid.Row="2" Visibility="Visible">
            <StackPanel>
                <Border Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Active Year Session" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" Margin="0,0,0,12"/>
                        <TextBlock Text="Filter the dashboard and global reports to a specific date range." Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="13" Margin="0,0,0,16"/>
                        
                        <DataGrid x:Name="GridSessions" AutoGenerateColumns="False" HeadersVisibility="Column" Background="{DynamicResource ThemeSurface_16213E_Surface}" Foreground="{DynamicResource ThemeText_D0D8F0_Text}" BorderThickness="1" BorderBrush="{DynamicResource TableBorder}" Margin="0,0,0,16" RowBackground="{DynamicResource ThemeSurface_1E2748_Surface}" AlternatingRowBackground="{DynamicResource ThemeSurface_16213E_Surface}" MaxHeight="200" VerticalScrollBarVisibility="Auto" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Start" Binding="{ui:PreferredDate DateStart}" Width="100"/>
                                <DataGridTextColumn Header="Finish" Binding="{ui:PreferredDate DateFinish}" Width="100"/>
                                <DataGridTemplateColumn Header="Action" Width="70">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Content="Delete" Foreground="{DynamicResource ThemeText_FF7182_Text}" Background="Transparent" BorderThickness="0" Click="BtnDeleteSession_Click" Tag="{Binding}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Title" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11"/><TextBox x:Name="TxtNewSessionTitle"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Start" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11"/><DatePicker x:Name="DtpNewSessionStart"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Finish" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11"/><DatePicker x:Name="DtpNewSessionFinish"/></StackPanel>
                            <Button Grid.Column="3" Content="Add Session" Width="100" Height="26" VerticalAlignment="Bottom" Background="#4361EE" Foreground="White" BorderThickness="0" Click="BtnAddSession_Click"/>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Active Dashboard Session:" Foreground="{DynamicResource ThemeText_8890AB_Text}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="CmbActiveSession" Width="200" DisplayMemberPath="Title"/>
                        </StackPanel>
                        
                    </StackPanel>
                </Border>
                <!-- Company Profile fields are now in the Company Profile tab -->
                <Border Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Storage Locations" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" Margin="0,0,0,8"/>
                        <TextBlock Text="Choose folders for the database and exported reports. Restart after changing the database location." Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="13" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Database Location -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Database" Foreground="{DynamicResource ThemeText_8890AB_Text}" VerticalAlignment="Top" Margin="0,8,8,0"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,16">
                                <TextBox x:Name="TxtDbLocation"/>
                                <TextBlock x:Name="TxtDefaultDbHint" Text="Default: ..." Foreground="{DynamicResource ThemeText_7E8BA8_Text}" FontSize="11" Margin="2,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,16">
                                <Button Content="Browse" Click="BtnBrowseDb_Click" Width="72" Height="36" Margin="0,0,6,0" Background="{DynamicResource ThemeSurface_2D2D4E_Surface}" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="Default" Click="BtnDefaultDb_Click" Width="68" Height="36" Background="{DynamicResource ThemeSurface_1E293B_Surface}" Foreground="{DynamicResource ThemeText_94A3B8_Text}" BorderThickness="0" Cursor="Hand" ToolTip="Reset to default database location"/>
                            </StackPanel>
                            
                            <!-- Exports Location -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Exports" Foreground="{DynamicResource ThemeText_8890AB_Text}" VerticalAlignment="Top" Margin="0,8,8,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                                <TextBox x:Name="TxtExportLocation"/>
                                <TextBlock x:Name="TxtDefaultExportHint" Text="Default: ..." Foreground="{DynamicResource ThemeText_7E8BA8_Text}" FontSize="11" Margin="2,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Browse" Click="BtnBrowseExport_Click" Width="72" Height="36" Margin="0,0,6,0" Background="{DynamicResource ThemeSurface_2D2D4E_Surface}" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="Default" Click="BtnDefaultExport_Click" Width="68" Height="36" Background="{DynamicResource ThemeSurface_1E293B_Surface}" Foreground="{DynamicResource ThemeText_94A3B8_Text}" BorderThickness="0" Cursor="Hand" ToolTip="Reset to default export location"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="12" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Preferences" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" Margin="0,0,0,8"/>
                        <TextBlock Text="Choose how dates are shown and save your preferred appearance." Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="13" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="THEME" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbTheme" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                                    <ComboBoxItem Content="Light" Tag="Light"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DATE FORMAT" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbDateFormat">
                                    <ComboBoxItem Content="dd/MM/yyyy"/>
                                    <ComboBoxItem Content="MM/dd/yyyy"/>
                                    <ComboBoxItem Content="yyyy-MM-dd"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Button Content="Save System Settings" Width="200" Height="40" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Background="#4361EE" Foreground="White" BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="BtnSaveSystem_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3451D1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="TxtSystemSaveStatus" Foreground="{DynamicResource ThemeText_06A77D_Text}" FontSize="13" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Company Profile Tab -->
        <ScrollViewer x:Name="PanelCompany" Grid.Row="2" Visibility="Collapsed">
            <StackPanel>
                <Border Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Company Profile" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}" Margin="0,0,0,4"/>
                        <TextBlock Text="These values are used in report templates via {{CompanyName}}, {{CompanyAddress}}, etc."
                                   Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="13" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- Logo picker -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="100" Height="70" Background="{DynamicResource ThemeSurface_0F1628_Surface}"
                                    BorderBrush="{DynamicResource ThemeSurface_3A3A5C_Surface}" BorderThickness="1" CornerRadius="6"
                                    Margin="0,0,16,0">
                                <Image x:Name="LogoPreview" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="COMPANY LOGO" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnPickLogo" Content="📁  Choose Logo..." Height="32"
                                            Background="{DynamicResource ThemeSurface_2D2D4E_Surface}" Foreground="White" BorderThickness="0"
                                            Padding="12,0" FontSize="12" Cursor="Hand"
                                            Click="BtnPickLogo_Click" Margin="0,0,8,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface_3D3D6E_Surface}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="BtnClearLogo" Content="✖ Clear" Height="32"
                                            Background="{DynamicResource ThemeSurface_3D1A1A_Surface}" Foreground="{DynamicResource ThemeText_FF6B6B_Text}" BorderThickness="0"
                                            Padding="10,0" FontSize="12" Cursor="Hand"
                                            Click="BtnClearLogo_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="PNG or JPG, max 2 MB. Embedded in PDF and DOCX report headers."
                                           Foreground="{DynamicResource ThemeText_4A5A7A_Text}" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Company fields -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Text="COMPANY NAME" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCompanyName"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                                <TextBlock Text="PHONE" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCompanyPhone"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="EMAIL" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCompanyEmail"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Text="ADDRESS" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCompanyAddress"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                                <TextBlock Text="WEBSITE" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCompanyWebsite"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Text="PREPARED BY" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPreparedBy"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,12">
                                <TextBlock Text="CHECKED BY" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCheckedBy"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="APPROVED BY" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtApprovedBy"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="DEFAULT HEADER TEXT" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDefaultHeader" AcceptsReturn="False"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <TextBlock Text="DEFAULT FOOTER TEXT" Foreground="{DynamicResource ThemeText_8890AB_Text}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDefaultFooter" AcceptsReturn="False"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Save Company Profile" Width="200" Height="40" HorizontalAlignment="Left" Margin="0,20,0,0"
                                Background="#4361EE" Foreground="White" BorderThickness="0" FontSize="14" Cursor="Hand"
                                Click="BtnSaveCompany_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3451D1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="TxtCompanySaveStatus" Foreground="{DynamicResource ThemeText_06A77D_Text}" FontSize="13" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Backup & Restore -->
        <ScrollViewer x:Name="PanelBackup" Grid.Row="2" Visibility="Collapsed">
            <StackPanel>
                <!-- Backup Card -->
                <Border Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="12" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="💾" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Create Backup" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"/>
                                <TextBlock Text="Creates a .tkbackup file containing your entire database" Foreground="{DynamicResource ThemeText_6B7A9A_Text}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="BtnCreateBackup" Content="Create Backup Now" Width="200" Height="40" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Background="#06A77D" Foreground="White" BorderThickness="0" FontSize="14" Cursor="Hand"
                                Click="BtnCreateBackup_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="TxtBackupStatus" Foreground="{DynamicResource ThemeText_06A77D_Text}" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Restore Card -->
                <Border Background="{DynamicResource ThemeSurface_16213E_Surface}" CornerRadius="12" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📂" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Restore from Backup" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText_FFFFFF_Text}"/>
                                <TextBlock Text="Restores database from a .tkbackup file. A safety copy is made first." Foreground="{DynamicResource ThemeText_6B7A9A_Text}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="{DynamicResource ThemeSurface_3A1010_Surface}" CornerRadius="8" Padding="12,8" Margin="0,12,0,14">
                            <TextBlock Text="⚠️ Restoring will replace ALL current data. This cannot be undone."
                                       Foreground="{DynamicResource ThemeText_FF8080_Text}" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                        <Button x:Name="BtnRestoreBackup" Content="Select Backup File &amp; Restore" Width="240" Height="40" HorizontalAlignment="Left"
                                Background="#D62839" Foreground="White" BorderThickness="0" FontSize="14" Cursor="Hand"
                                Click="BtnRestoreBackup_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="TxtRestoreStatus" Foreground="{DynamicResource ThemeText_F7A400_Text}" FontSize="12" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
